---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const entries = await getCollection('poradniki', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = entry.data.toc ? headings.filter((h) => h.depth === 2) : [];
---
<Article
  id={`poradniki/${entry.id}`}
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  tags={entry.data.tags}
  section={{ href: '/poradniki/', label: 'Poradniki' }}
>
  {toc.length > 0 && (
    <nav class="toc" aria-label="Spis treści">
      <h2>Spis treści</h2>
      <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text.replace(/^\d+\.\s*/, '')}</a></li>)}</ol>
    </nav>
  )}
  <Content />
</Article>
