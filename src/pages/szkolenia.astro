---
import SectionImage from '../components/SectionImage.astro';
import Base from '../layouts/Base.astro';
---
<Base title="Szkolenia" description="Warsztaty dla osób w momentach przejścia.">
  <div class="narrow">
    <h1>Szkolenia</h1>
    <p class="lead">Warsztaty dla osób w momentach przejścia.</p>
    <SectionImage file="cypr-brzeg" position="center 85%" alt="Skalisty brzeg morza, na kamieniach cienie dwóch osób" />
    <h2>Warsztaty</h2>
    <ul class="cards">
      <li class="card">
        <h3><a href="/szkolenia/warsztat-tranzytu/">Warsztat tranzytu. Dwa dni na progu</a></h3>
        <p>Dwudniowy warsztat wyjazdowy dla osób, które stoją przed ważnym przejściem w życiu albo noszą w sobie niedomknięte zakończenie. Do 10 osób.</p>
      </li>
    </ul>

  </div>
</Base>
