---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TextList from '../../components/TextList.astro';

const items = (await getCollection('eseje', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((e) => ({ href: `/eseje/${e.id}/`, title: e.data.title, description: e.data.description }));
---
<Base title="Eseje" description="Dłuższe teksty o przyszłości, technologii i kompetencjach.">
  <div class="wrap">
    <h1>Eseje</h1>
    <p class="lead">Dłuższe teksty o przyszłości, technologii i kompetencjach.</p>
    <TextList items={items} />
  </div>
</Base>
