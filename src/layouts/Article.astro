---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  section: { href: string; label: string };
  // Okładka obok tytułu (nazwa pliku w public/fotografie bez sufiksu rozmiaru).
  cover?: string;
}
const { id, title, description, date, tags = [], section, cover } = Astro.props;
const fmt = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'long' });
---
<Base title={title} description={description} type="article">
  <article class="narrow">
    <p class="meta"><a href={section.href}>{section.label}</a>{date && <> · <time datetime={date.toISOString()}>{fmt.format(date)}</time></>}</p>
    {cover ? (
      <div class="cover-head">
        <div>
          <h1>{title}</h1>
          <p class="lead">{description}</p>
        </div>
        <img class="cover" src={`/fotografie/${cover}-400.webp`} srcset={`/fotografie/${cover}-400.webp 400w, /fotografie/${cover}-800.webp 800w`} sizes="12rem" alt={`Okładka książki „${title}”`} width="400" height="600" decoding="async" />
      </div>
    ) : (
      <>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </>
    )}
    {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
    <div class="prose">
      <slot />
    </div>
    <Comments id={id} title={title} />
  </article>
</Base>
